# syntax=docker/dockerfile:1.7

ARG RUST_ARTIFACT_SOURCE=source-builder
FROM rust:1.97.1-alpine@sha256:3c38f3f82c2f3d73da3b38e18d279393a04cb43ddded0e35088a8c3324d40900 AS builder-env
ARG TARGETPLATFORM
RUN <<'EOF'
set -eu
apk add --no-cache bash python3
mkdir -p /identity
rustc -vV > /tmp/rustc-vv
cargo -V > /tmp/cargo-version
apk info -vv | LC_ALL=C sort > /tmp/native-packages
TARGET_PLATFORM="$TARGETPLATFORM" python3 - <<'PY'
import json, os
value={"cargo_version":open("/tmp/cargo-version",encoding="utf-8").read().rstrip("\n"),"format":"lagrange-build-layout-native-v1","native_packages":open("/tmp/native-packages",encoding="utf-8").read().splitlines(),"rustc_vv":open("/tmp/rustc-vv",encoding="utf-8").read(),"target_platform":os.environ["TARGET_PLATFORM"]}
with open("/identity/identity.json","w",encoding="utf-8",newline="\n") as out: out.write(json.dumps(value,sort_keys=True,separators=(",",":"))+"\n")
PY
EOF
ENV CARGO_BUILD_JOBS=2
ENV CARGO_TARGET_DIR=/cargo-target
WORKDIR /build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

FROM scratch AS identity
COPY --from=builder-env /identity/identity.json /identity.json

# This stage is selected only by source-fallback. PROBE_SOURCE_TRAP is an
# internal route-contract assertion, not an external CLI option.
FROM builder-env AS source-builder
ARG BIN
ARG VARIANT=base
ARG RUNTIME_FILE
ARG CACHE_FIXTURE_COMMIT
ARG CACHE_FIXTURE_BUILD_SETTING=default
ARG CACHE_FIXTURE_RUN_TOKEN=initial
ARG PROBE_SHARED_CACHE_ID
ARG PROBE_TARGET_CACHE_ID
ARG PROBE_SOURCE_TRAP=0
ARG PROBE_CARGO_CONFIG=default
ARG PROBE_EXPECTED_NATIVE_SHA256
ARG PROBE_COMPILE_INPUT_SHA256
ARG PROBE_LIB_HASH
ARG PROBE_APP_HASH
ARG PROBE_PLATFORM=linux/amd64
ARG PROBE_HOST_TRIPLE
ENV CACHE_FIXTURE_COMMIT="$CACHE_FIXTURE_COMMIT"
ENV CACHE_FIXTURE_BUILD_SETTING="$CACHE_FIXTURE_BUILD_SETTING"
COPY Cargo.toml Cargo.lock rust-toolchain.toml layout.json layout-helper.sh ./
COPY fixture-lib ./fixture-lib
COPY fixture-app ./fixture-app
COPY runtime ./runtime
RUN set -euo pipefail; \
    install -m 0755 /build/layout-helper.sh /usr/local/bin/layout-helper.sh; \
    printf '%s  %s\n' "$PROBE_EXPECTED_NATIVE_SHA256" /identity/identity.json | sha256sum -c -; \
    [[ "$(/usr/local/bin/layout-helper.sh identity-validate /identity/identity.json "$PROBE_PLATFORM")" = "$PROBE_HOST_TRIPLE" ]]; \
    /usr/local/bin/layout-helper.sh guard-inputs /build "$PROBE_COMPILE_INPUT_SHA256" "$PROBE_LIB_HASH" "$PROBE_APP_HASH"; \
    [[ "$PROBE_SOURCE_TRAP" = 0 ]]; \
    [[ "$CACHE_FIXTURE_COMMIT" =~ ^[0-9a-f]{40}$ ]]; \
    [[ "$BIN" = cache-bin-a || "$BIN" = cache-bin-b ]]; \
    [[ "$VARIANT" = base || "$VARIANT" = wide ]]; \
    [[ "$RUNTIME_FILE" = web.txt || "$RUNTIME_FILE" = python.txt ]]
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=${PROBE_SHARED_CACHE_ID}-registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,id=${PROBE_SHARED_CACHE_ID}-git,sharing=locked \
    --mount=type=cache,target=/cargo-target,id=${PROBE_TARGET_CACHE_ID},sharing=locked <<'EOF'
set -euo pipefail
cargo clean --workspace --release --locked
[[ -n "$CACHE_FIXTURE_RUN_TOKEN" ]]
started=$(python3 -c 'import time; print(time.time_ns() // 1000000)')
if [[ "$VARIANT" = wide ]]; then
  if [[ "$PROBE_CARGO_CONFIG" = build.jobs=2 ]]; then
    cargo build --locked --release --verbose --message-format=json-render-diagnostics --config build.jobs=2 --package build-cache-fixture-app --bin "$BIN" --features wide
  else
    cargo build --locked --release --verbose --message-format=json-render-diagnostics --package build-cache-fixture-app --bin "$BIN" --features wide
  fi
else
  if [[ "$PROBE_CARGO_CONFIG" = build.jobs=2 ]]; then
    cargo build --locked --release --verbose --message-format=json-render-diagnostics --config build.jobs=2 --package build-cache-fixture-app --bin "$BIN"
  else
    cargo build --locked --release --verbose --message-format=json-render-diagnostics --package build-cache-fixture-app --bin "$BIN"
  fi
fi
finished=$(python3 -c 'import time; print(time.time_ns() // 1000000)')
printf 'BUILD_LAYOUT_CARGO_MS=%s\n' "$((finished - started))"
[[ -x "/cargo-target/release/$BIN" ]]
mkdir -p /out
install -m 0755 "/cargo-target/release/$BIN" /out/probe-bin
cp -- "/build/runtime/$RUNTIME_FILE" /out/runtime.txt
EOF

FROM builder-env AS verified-artifacts
ARG BIN
ARG CACHE_FIXTURE_COMMIT
ARG CACHE_FIXTURE_BUILD_SETTING=default
ARG PROBE_PLATFORM=linux/amd64
ARG PROBE_HOST_TRIPLE
ARG PROBE_CACHE_KEY
ARG PROBE_INPUT_SHA256
ARG PROBE_RECIPE_SHA256
ARG PROBE_FEATURES_JSON=[]
COPY --from=release_artifacts / /release-artifacts/
COPY layout-helper.sh /tmp/layout-helper.sh
RUN set -euo pipefail; \
    install -m 0755 /tmp/layout-helper.sh /usr/local/bin/layout-helper.sh; \
    compile_env=$(printf '%s' '{"CACHE_FIXTURE_BUILD_SETTING":"'"$CACHE_FIXTURE_BUILD_SETTING"'","CACHE_FIXTURE_COMMIT":"'"$CACHE_FIXTURE_COMMIT"'","CARGO_BUILD_JOBS":"2","CARGO_TARGET_DIR":"/cargo-target"}'); \
    /usr/local/bin/layout-helper.sh artifact-verify /release-artifacts "$CACHE_FIXTURE_COMMIT" build-cache-fixture-app "$BIN" "$PROBE_PLATFORM" "$PROBE_HOST_TRIPLE" release "$PROBE_FEATURES_JSON" "$compile_env" "$PROBE_CACHE_KEY" "$PROBE_INPUT_SHA256" "$PROBE_RECIPE_SHA256"; \
    mkdir -p /out; \
    install -m 0755 "/release-artifacts/bin/$BIN" /out/probe-bin; \
    cp -- /release-artifacts/runtime.txt /out/runtime.txt

FROM ${RUST_ARTIFACT_SOURCE} AS builder

FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d AS runtime
ARG BIN
ARG CACHE_FIXTURE_COMMIT
RUN addgroup -S -g 10001 fixture \
    && adduser -S -D -H -u 10001 -G fixture fixture
WORKDIR /opt/fixture
COPY --from=builder /out/probe-bin /out/probe-bin
COPY --from=builder /out/runtime.txt /opt/fixture/runtime.txt
RUN set -eu; \
    install -m 0755 /out/probe-bin "/usr/local/bin/$BIN"; \
    printf '%s\n' '#!/bin/sh' "exec /usr/local/bin/$BIN" > /usr/local/bin/fixture-entrypoint; \
    chmod 0755 /usr/local/bin/fixture-entrypoint; \
    rm -f /out/probe-bin
LABEL org.opencontainers.image.revision="$CACHE_FIXTURE_COMMIT"
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/fixture-entrypoint"]

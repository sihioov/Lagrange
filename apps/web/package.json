{
  "name": "@lagrange/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secure authenticated Next.js application shell for Lagrange Station.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "react-doctor --json"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "geist": "1.7.2",
    "ky": "2.0.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react-doctor": "0.9.5",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}

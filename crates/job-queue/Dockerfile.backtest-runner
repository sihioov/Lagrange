# Production backtest queue runner.
#
# The Rust daemon owns queue leases and invokes the pinned Python NT worker as
# a child for each job. Keep both halves in one immutable image so a queue job
# cannot accidentally resolve a host interpreter or an unreviewed strategy
# checkout.

FROM rust:1.97.1-alpine@sha256:3c38f3f82c2f3d73da3b38e18d279393a04cb43ddded0e35088a8c3324d40900 AS builder

RUN apk add --no-cache build-base musl-dev pkgconf openssl-dev postgresql-dev
WORKDIR /build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY nt ./nt
COPY configs/evidence/kis-range-canonical-approved-manifests.json ./configs/evidence/kis-range-canonical-approved-manifests.json
COPY configs/evidence/kis-historical-price-only-beta-approved-artifacts.json ./configs/evidence/kis-historical-price-only-beta-approved-artifacts.json
COPY configs/universes ./configs/universes
COPY data/calendars/xkrx/calendar.json ./data/calendars/xkrx/calendar.json
COPY data/calendars/xkrx/manifest.json ./data/calendars/xkrx/manifest.json
COPY data/calendars/xkrx/overrides.json ./data/calendars/xkrx/overrides.json
COPY data-pipelines/collectors ./data-pipelines/collectors
COPY apps/api-server/auth ./apps/api-server/auth
COPY tests/integration/migration-contract ./tests/integration/migration-contract

ARG LAGRANGE_CODE_COMMIT
RUN test -n "$LAGRANGE_CODE_COMMIT" \
    && printf '%s' "$LAGRANGE_CODE_COMMIT" | grep -Eq '^[0-9a-f]{40}$'
# Pass the same attestation into the Rust release build. The binary compares
# its compiled value with the runtime ENV, so `docker run -e` cannot relabel a
# result even outside Compose.
ENV LAGRANGE_CODE_COMMIT="$LAGRANGE_CODE_COMMIT"
RUN cargo build --locked --release --package job-queue --bin backtest-runner

FROM python@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db

# Keep the image revision in both the OCI metadata and the process
# environment. Compose supplies this only as a build argument; it deliberately
# does not repeat it under `environment`, so an operator cannot relabel a run
# by overriding the runtime value in deployment wiring.
ARG LAGRANGE_CODE_COMMIT
RUN test -n "$LAGRANGE_CODE_COMMIT" \
    && printf '%s' "$LAGRANGE_CODE_COMMIT" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision="$LAGRANGE_CODE_COMMIT"
ENV LAGRANGE_CODE_COMMIT="$LAGRANGE_CODE_COMMIT"

RUN pip install --no-cache-dir uv==0.9.17 \
    && groupadd --system --gid 10001 lagrange \
    && useradd --system --uid 10001 --gid lagrange --home-dir /opt/lagrange --shell /usr/sbin/nologin lagrange

WORKDIR /opt/lagrange
COPY --from=builder /build/target/release/backtest-runner /usr/local/bin/backtest-runner
COPY --from=builder /build/nt ./nt
RUN uv sync --project /opt/lagrange/nt --locked \
    && chown -R lagrange:lagrange /opt/lagrange

USER 10001:10001
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["/usr/local/bin/backtest-runner", "readiness"]
ENTRYPOINT ["/usr/local/bin/backtest-runner"]

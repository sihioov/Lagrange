package "Frontend (TypeScript / Node 24)" #E8F1FB {
  component "apps/web\n(Next.js 16 shell;\nHTTP + schema2 SSE client)" as web
  component "apps/api-server\n(OpenAPI contract pkg:\nopenapi.json + generated/openapi.ts)" as api_contract
}

package "Rust workspace (edition 2024)" {

  package "HTTP layer" #FDEEDC {
    component "crates/api-server\n(Axum REST authority,\nActor+RLS repos;\nWS-backed realtime + lease/SSE HTTP;\nalso hosts paper-runner bin)" as api_server
    component "apps/api-server/auth\n(api-server-auth:\nOIDC/session HTTP router)" as api_server_auth
  }

  package "Orchestration" #FBE4EC {
    component "crates/job-queue\n(PG job queue + runner bins:\nbacktest / recommendation /\ncandidate / owner-beta /\nowner-equity-v2;\nWS-only realtime producer;\nopt-in WS state initializer)" as job_queue
    component "owner_beta::runner daily modules\n(producer / independent admitter,\nminute-gated local state,\nscheduler + mixed queue execution)\n[inside job-queue]" as daily_runner
    component "owner_beta::simulation_execution\n(typed input, attested child,\nlease/cancel/recovery, whole-pair publication)\n[inside job-queue; source only]" as simulation_execution
  }

  package "Research & results" #F1E6F7 {
    component "crates/factor-engine\n(Polars factor snapshots)" as factor_engine
    component "crates/selector\n(fixed-universe selection,\ntarget portfolios)" as selector
    component "crates/portfolio-model\n(sizing, costs, ledger)" as portfolio_model
    component "crates/result-model\n(common result model,\npaper parity)" as result_model
    component "owner_beta::simulation\n(fixed price-only engine;\nillustrative + zero-cost pair)\n[inside job-queue]" as simulation_engine
  }

  package "Live-trading guard" #FBE5E5 {
    component "crates/risk-gateway\n(persisted order gate)" as risk_gateway
  }

  package "Data layer" #E5F3E7 {
    component "crates/market-data\n(EOD + calendar-only contract, RawStore,\nCurateStore, providers;\nintraday typed parser)" as market_data
    component "data-pipelines/collectors\n(research-worker + raw-capture\n& materialize bins;\nowner intraday adapter + day bootstrap)" as collectors
  }

  package "External source clients" #FCF8DE {
    component "crates/kis-client\n(KIS REST + market-only WS;\nseparate coordination + WS state)" as kis_client
    component "crates/opendart-client\n(OpenDART, 3 approved paths)" as opendart_client
    component "crates/data-go-client\n(FSC KRX listed-info)" as data_go_client
  }

  package "Foundation" #EBEFF2 {
    component "crates/domain\n(shared primitives:\nIDs, Money, TradingDate)" as domain
    component "crates/auth\n(OIDC, sessions, RBAC,\nentitlement gate)" as auth
  }
}


@startuml component_architecture
' =====================================================================
' Lagrange Station — static component / code-dependency architecture
' Generated 2026-09-01 from manifest + code-usage evidence.
' Every drawn arrow carries an evidence comment ("' evidence: <file:line>")
' pointing at the concrete code that makes the edge exist:
'   - Rust edges: Cargo.toml path dependency PLUS a real `use`/call site.
'   - Python edges: importlib / NT-config dynamic import sites.
'   - Cross-language edges: the exact process-spawn site.
' Edges with no code usage do not appear. Empty placeholder directories
' (nt/paper-runner, data-pipelines/normalizers, data-pipelines/validators,
' data-pipelines/nt-catalog-builder) are intentionally NOT components.
' The workspace member tests/integration/migration-contract is a test-only
' gate crate (sqlx::migrate! over migrations/) and is likewise omitted.
'
' READABILITY: ubiquitous foundation dependencies are FOLDED (not drawn).
' Nine crates depend on crates/domain and four components consume
' crates/auth (the leaf crates auth, kis-client, opendart-client and
' data-go-client have NO local dependencies at all). Drawing the folded
' edges adds 13 crossing lines and zero information.
' The folded edges and their code evidence:
'   api-server      -> domain  ' evidence: crates/api-server/src/live_order.rs:42
'   factor-engine   -> domain  ' evidence: crates/factor-engine/src/contract.rs:7
'   selector        -> domain  ' evidence: crates/selector/src/builder.rs:12
'   portfolio-model -> domain  ' evidence: crates/portfolio-model/src/paper_flow.rs:26
'   result-model    -> domain  ' evidence: crates/result-model/src/lib.rs:11
'   risk-gateway    -> domain  ' evidence: crates/risk-gateway/src/snapshot.rs:18
'   job-queue       -> domain  ' evidence: crates/job-queue/src/paper_valuation.rs:14
'   market-data     -> domain  ' evidence: crates/market-data/src/contract.rs:27
'   collectors      -> domain  ' evidence: data-pipelines/collectors/src/stock_price_beta_raw.rs:12
'   api-server      -> auth    ' evidence: crates/api-server/src/actor_tx.rs:15
'   api-server-auth -> auth    ' evidence: apps/api-server/auth/src/lib.rs:22-26
'   market-data     -> auth    ' evidence: crates/market-data/src/entitlement.rs:13
'   selector        -> auth    ' evidence: crates/selector/src/publish.rs:28
' =====================================================================

title Lagrange Station — Component Architecture (code dependencies)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 45
skinparam ArrowColor #555555
skinparam noteBackgroundColor #FFFFF0

package "Frontend (TypeScript / Node 24)" #E8F1FB {
  component "apps/web\n(Next.js 16 shell)" as web
  component "apps/api-server\n(OpenAPI contract pkg:\nopenapi.json + generated/openapi.ts)" as api_contract
}

package "Rust workspace (edition 2024)" {

  package "HTTP layer" #FDEEDC {
    component "crates/api-server\n(Axum REST authority,\nActor+RLS repos;\nalso hosts paper-runner bin)" as api_server
    component "apps/api-server/auth\n(api-server-auth:\nOIDC/session HTTP router)" as api_server_auth
  }

  package "Orchestration" #FBE4EC {
    component "crates/job-queue\n(PG job queue + runner bins:\nbacktest / recommendation /\ncandidate / owner-beta /\nowner-equity-v2)" as job_queue
  }

  package "Research & results" #F1E6F7 {
    component "crates/factor-engine\n(Polars factor snapshots)" as factor_engine
    component "crates/selector\n(fixed-universe selection,\ntarget portfolios)" as selector
    component "crates/portfolio-model\n(sizing, costs, ledger)" as portfolio_model
    component "crates/result-model\n(common result model,\npaper parity)" as result_model
  }

  package "Live-trading guard" #FBE5E5 {
    component "crates/risk-gateway\n(persisted order gate)" as risk_gateway
  }

  package "Data layer" #E5F3E7 {
    component "crates/market-data\n(EOD contract, RawStore,\nCurateStore, providers)" as market_data
    component "data-pipelines/collectors\n(research-worker + raw-capture\n& materialize bins)" as collectors
  }

  package "External source clients" #FCF8DE {
    component "crates/kis-client\n(KIS REST, read-only allowlist)" as kis_client
    component "crates/opendart-client\n(OpenDART, 3 approved paths)" as opendart_client
    component "crates/data-go-client\n(FSC KRX listed-info)" as data_go_client
  }

  package "Foundation" #EBEFF2 {
    component "crates/domain\n(shared primitives:\nIDs, Money, TradingDate)" as domain
    component "crates/auth\n(OIDC, sessions, RBAC,\nentitlement gate)" as auth
  }
}

note bottom of domain
  Depended on by the 9 service crates
  (edges folded; evidence in this file's
  header comment). The leaf client crates
  and auth have no local dependencies.
end note

note bottom of auth
  Consumers (edges folded):
  sessions/OIDC: api-server, api-server-auth
  entitlement gate: market-data, selector
end note

package "Python NT workspace (nt/, NautilusTrader 1.231.0 via uv)" #E0F4F6 {
  component "nt/backtest-worker\n(isolated NT backtest\nsupervisor + child)" as backtest_worker
  component "nt/strategies\n(strategy packages +\nrecommendation_cli)" as strategies
  component "nt/custom-data\n(SessionOpenEvent/DailyBarClosedEvent,\ncatalog_builder)" as custom_data
  component "nt/live-node\n(credential-free dry-run\nreconciliation simulator)" as live_node
}

package "Operator tools (Node)" #F2F2F2 {
  component "data-pipelines/kind-capture\n(Playwright KIND browser capture)" as kind_capture
}


@startuml runtime_deployment
' =====================================================================
' Lagrange Station — runtime / deployment view (single-host Compose)
' Generated 2026-09-04 from deploy/compose/compose.yml, deploy/nginx/nginx.conf,
' migrations/, and code spawn/publication sites.
' WP6-C2a source delta 2026-09-09: intraday code/cache topology and
' explicit preparation overlay only; no runtime activation is claimed.
' 2026-09-14: operational day proof and calendar-only bootstrap; activation unverified.
' 2026-09-19: same-day calendar-source reuse and recovery evidence accepted;
' installed release/image/daemon and live activation remain unverified.
' 2026-09-11: release wrapper conditionally selects the fixed shared overlay;
' Web receives server-only mode. Source wiring is not a deployment claim.
' 2026-10-03: conditional market-stream source topology and HTTP6 validation;
' 2026-10-04: bounded local end-to-end soak and fault evidence recovered;
' live provider and installed activation remain unverified.
' 2026-10-07: production realtime selection is WS-only; independent EOD
' REST remains. Source topology is separate from bounded activation receipts.
' Arrows mean actual communication (HTTP / SQL / file I/O / process spawn),
' NOT compose depends_on (which is startup ordering only).
' Every arrow carries an evidence comment ("' evidence: <file:line>").
' <<profile:X>> services are inactive in the default deployment.
' Live trading is explicitly out of scope: live-node-owner is a
' credential-free simulator with network_mode: none.
' =====================================================================

title Lagrange Station — Runtime & Deployment (docker compose, single host)

skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 80
skinparam ArrowColor #555555
top to bottom direction

actor "Owner / invited user\n(browser)" as user

cloud "Auth0\n(OIDC IdP)" as auth0
cloud "KIS Open API\n(read-only market data,\ndeny-by-default allowlist)" as kis

' Packages below are presentation tiers, not exact network membership:
' web and api-server are attached to BOTH the edge and backend networks
' (compose.yml:124-126 web, compose.yml:264-266 api-server), which is how
' nginx reaches api-server and web reaches api-server internally.
package "edge tier" #E8F1FB {
  node "reverse-proxy\n(nginx, ONLY published port 443->8443)" as nginx
  node "web\n(Next.js 16 standalone;\nHTTP + schema2 SSE client)" as web
}

package "backend tier" #FDEEDC {
  node "api-server\n(Axum REST authority :8080;\nschema2 latest cache + SSE;\nPOST/DELETE leases)" as api
  node "research-worker\n(daily KIS EOD ingest,\ncurate, catalog publish)" as research
  node "recommendation-runner\n(fixed 11-ETF targets)" as reco
  node "candidate-runner\n(KOSPI200/KOSDAQ150\nscreener & analysis)" as cand
  node "paper-scheduler\n(paper-runner bin from\ncrates/api-server)" as paper
  node "metrics <<profile:monitoring>>\n(Prometheus)" as prom
  node "db-role-bootstrap / db-migrate /\nresearch-raw-init / research-schema-check\n(one-shot gates)" as oneshots
}

package "backtest-iso network (internal: true, no egress)" #E5F3E7 {
  node "nt-backtest-worker-1/2\n(Rust backtest-runner supervisor\n+ spawned NT Python child)" as btw
}

package "profile-gated (inactive by default)" #F2F2F2 {
  node "owner-beta-runner\n<<profile:owner-beta>>\n(sealed price-beta recommendations)" as obr
  node "owner-equity-v2-runner\n<<profile:owner-equity-v2>>\n(owner-managed equity universe V2;\noptional market-WS realtime loop;\ndefault off; independent EOD continues)" as oev2
  node "research-range-raw /\nresearch-action-range-raw /\nresearch-stock-price-beta-raw\n<<profiles, one-shot KIS capture>>\n(3 grouped credentialed readers)" as rangejobs
  node "research-stock-price-beta-materialize\n<<profile, network_mode: none>>" as materialize
  node "research-v3-input-check\n<<profile, network_mode: none>>" as v3check
  node "research-range-raw-recovery\n<<profile, network_mode: none>>\n(Stage5 recovery from committed Raw)" as recovery
  node "live-node-owner <<profile:live>>\n(credential-free dry-run simulator,\nnetwork_mode: none, no order path)" as livenode
}

database "postgres (PG 18)\nroles: app / worker / research_writer /\naudit_writer / admin / migration_owner\ntable groups: identity, strategy,\nmarket_data, research, jobs, backtest,\nportfolio_trading, operations, candidate,\nowner-beta, equity-universe-v2,\nowner-intraday (0054), market-stream (0055–0057)\napp actor RLS + worker fenced writes" as pg

folder "Raw zone\n/data/raw (immutable batches\n+ JSONL manifests)" as raw
folder "Curated zone\n/data/curated (per-instrument\nParquet bars)" as curated
folder "Artifact tree\n/data/artifacts\n(backtest/runs, paper,\nhistorical-price-beta-root)" as artifacts
folder "stock-price-beta-artifacts\n(sealed fixed-30 signals)" as spba
folder "owner-equity-v2-artifacts" as oeva

package "INTRADAY OVERLAY — SHARED READ + OPERATIONAL DAY PROOF\ncompose.intraday.yml\nDEFAULT OFF • ACTIVATION GATED" #FFF4D6 {
  folder "Protected KIS read coordination\n/run/lagrange/kis-read-coordination\nshared host leaf; contains bearer token\n+ durable coordination ledger" as kis_coordination
  folder "KST session-window artifact\n/opt/lagrange/configs/market-hours/\nkrx-intraday-session-windows-v1.json\nread-only; hash-pinned; committed entries empty" as intraday_windows
  folder "Operational day proof\n/run/lagrange/intraday-session-windows\nactivation.json + immutable windows-<sha>.json\nroot protected; read-only" as operational_windows
}

package "MARKET STREAM OVERLAY — SOURCE ONLY\ncompose.market-stream.yml\nDEFAULT OFF • LIVE APPROVAL GATED" #FCE8D5 {
  folder "Separate durable WS state\n/run/lagrange/kis-market-stream\nUID10001; runtime read/write" as ws_state
  folder "Stable root-owned WS anchors\n/run/lagrange/kis-market-stream-locks\nread-only bind; no auto-creation" as ws_anchors
}

package "MANUAL WS PREPARATION — OPERATOR GATED\nsource contracts; LIVE_ACCEPTED is separate" #FCE8D5 {
  node "Installed operator helpers\nexact current release + image pins\ndefault plan; explicit apply" as ws_ops
  node "Opt-in state initializer\nrunner image; network none\nroot create / UID10001 validate" as ws_init
  node "db-migrate image\none-off psql, migration_owner\nreviewed grant / explicit revoke" as ws_grant
}


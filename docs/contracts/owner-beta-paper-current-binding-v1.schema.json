  "$id": "urn:lagrange:owner-beta-paper-current-binding-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "anyOf": [
          {
            "properties": {
              "binding": {
                "type": "null"
              },
              "binding_sha256": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "binding": {
                "$ref": "#/$defs/binding"
              },
              "binding_sha256": {
                "format": "sha256",
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            }
          }
        ],
        "properties": {
          "reason": {
            "enum": [
              "STARTING",
              "STOPPED",
              "CONFIG_CHANGED",
              "CLOCK_INVALID",
              "REPLACED",
              "UNKNOWN"
            ]
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "CURRENT"
          }
        }
      },
      "then": {
        "properties": {
          "binding": {
            "$ref": "#/$defs/binding"
          },
          "binding_sha256": {
            "format": "sha256",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "const": "NONE"
          }
        }
      }
    }
  ],
  "description": "Canonical UTF-8 <=65536 bytes, depth<=16. CURRENT requires NONE and non-null binding/digest; INVALID requires non-NONE and matched binding/digest nullability. Semantic hash, boot/clocks, protected metadata and live lock are runtime requirements, not JSON authority.",
  "properties": {
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding_sha256": {
      "anyOf": [
        {
          "format": "sha256",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "boot_id": {
      "format": "uuid",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "generation": {
      "format": "uuid",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "observed": {
      "$ref": "#/$defs/clock"
    },
    "publisher": {
      "$ref": "#/$defs/process"
    },
    "reason": {
      "enum": [
        "NONE",
        "STARTING",
        "STOPPED",
        "CONFIG_CHANGED",
        "CLOCK_INVALID",
        "REPLACED",
        "UNKNOWN"
      ]
    },
    "schema": {
      "const": "owner-beta-paper-current-binding-v1",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "enum": [
        "CURRENT",
        "INVALID"
      ]
    }
  },
  "required": [
    "schema",
    "status",
    "reason",
    "generation",
    "boot_id",
    "publisher",
    "sequence",
    "observed",
    "binding_sha256",
    "binding"
  ],
  "title": "Untrusted current selector envelope; protected live OFD fence required separately",
  "type": "object"

    "filters": "No caller application_name filter participates in a root. Table rows are restricted by configured owner/account or joined through beta target/outbox/job identities.",
    "sql_boundary": "The root controller supplies inventory_sha256 only after protected process/backend proof. SQL independently rejects active app/worker transactions and prepared transactions, serializes on Paper control/account locks, and re-reads DB state. SQL does not claim that an arbitrary inventory digest proves host termination.",
    "journal_boundary": "owner_beta_paper_operations, owner_beta_paper_operation_observations, and owner_beta_paper_recovery_grants are excluded. owner_beta_paper_events and owner_beta_paper_session_events remain included as existing immutable source history.",
    "reconciliation_summary": "The returned reconciliation schema and field types are exactly those in owner-beta-paper-operations-v1.schema.json. The database root is the framed root over database_root_projection plus one child-root reference for ledger, pending, outbox, and jobs.",
    "row_key_text": {
      "account_strategy_bindings": "id UUID lowercase",
      "accounts": "id UUID lowercase",
      "jobs": "account UUID lowercase synthetic child-root row key",
      "ledger": "account UUID lowercase synthetic child-root row key",
      "outbox": "account UUID lowercase synthetic child-root row key",
      "owner_beta_paper_control": "id text, currently etf11",
      "owner_beta_paper_events": "id UUID lowercase",
      "pending": "account UUID lowercase synthetic child-root row key",
      "cash_ledger": "account_id:base-10 seq",
      "positions": "account_id:instrument_id",
      "orders": "account_id:order_ref",
      "fills": "account_id:fill_ref",
      "daily_equity": "account_id:YYYY-MM-DD trading_date",
      "pending_targets": "id UUID lowercase",
      "owner_beta_paper_sessions": "pending_target_id UUID lowercase",
      "owner_beta_paper_lineage": "id UUID lowercase",
      "owner_beta_paper_session_events": "pending_target_id UUID lowercase:20-digit-zero-padded event_seq",
      "paper_settlement_outbox": "id UUID lowercase",
      "paper_settlement_outbox_archive": "id UUID lowercase",
      "notifications": "id UUID lowercase",
      "notification_deliveries": "notification_id UUID lowercase:channel",
      "job_attempts": "id UUID lowercase",
      "paper_rebalance_previews": "id UUID lowercase"
    }
  },

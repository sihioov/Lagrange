{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owner-beta-paper-audit-projection-v1.json",
  "title": "Owner-beta Paper source-owned SQL audit projection v1",
  "status": "companion projection for the coordinator-adopted owner-beta-paper-operations-v1 contract",
  "canonicalization": {
    "wire_json": "New operation wires use printable ASCII UTF-8, no BOM/whitespace/final LF, ASCII byte-sorted object keys, JSON string escaping, nonnegative canonical signed-i64 integers, and exact schema key sets. SQL hashes this projection with paper_0068_canonical_json; P2 validates original bytes before jsonb decoding.",
    "audit_row_json": "Persisted source rows use recursive JSON canonicalization with C-collation object-key ordering, JSON string escaping, UTF-8 strings, null preservation, normalized base-10 JSON numbers, and declared array order. They use paper_0068_canonical_row_json, not jsonb::text.",
    "row_order": "Sort by physical table label and row_key using PostgreSQL C collation. Keys are printable ASCII. Each frame is decimal UTF-8 byte length, ':', table label, decimal byte length, ':', row_key, decimal byte length, ':', canonical row bytes. Root is lowercase sha256 over concatenated frames; an empty stream is SHA256(empty).",
    "normalization": "SQL NULL is JSON null; UUID lowercase canonical text; date YYYY-MM-DD; timestamptz UTC with six fractional digits; economic numeric(18,4) values fixed to four decimal places as strings; nested jsonb uses audit_row_json. Raw error prose is represented by its SHA-256 digest.",
    "root_hash_text": "sha256: followed by 64 lowercase hexadecimal digits",
    "exact_receipts": "Additive request_canonical/request_sha256/result_canonical/result_sha256 columns are preserved byte-for-byte, including all-null historical rows, in event reconciliation and the three archive table projections. They hash exact ASCII canonical text, independently of legacy payload_sha256."
  },
  "reconciliation_v1": {
    "purpose": "Complete pre-OFF SQL observation. The operations, observations, and recovery-grants tables are excluded to prevent self-reference. Existing immutable Paper event rows are included.",
    "database_root_order": [
      "account_strategy_bindings",
      "accounts",
      "jobs",
      "ledger",
      "outbox",
      "owner_beta_paper_control",
      "owner_beta_paper_events",
      "pending"
    ],
    "database_root_projection": [
      {
        "table": "account_strategy_bindings",
        "key": [
          "id"
        ],
        "columns": [
          "id",
          "account_id",
          "owner_user_id",
          "strategy_config_id",
          "strategy_id",
          "strategy_version",
          "bound_at",
          "unbound_at"
        ]
      },
      {
        "table": "accounts",
        "key": [
          "id"
        ],
        "columns": [
          "id",
          "owner_user_id",
          "account_type",
          "name",
          "currency",
          "status",
          "created_at",
          "updated_at",
          "initial_cash as fixed-scale string",
          "cost_profile_id",
          "cost_profile_version",
          "paper_state_version as integer"
        ]
      },
      {
        "table": "jobs",
        "key": [
          "account_id"
        ],
        "projection": "One row whose value is the jobs_sha256 child root."
      },
      {
        "table": "ledger",
        "key": [
          "account_id"
        ],
        "projection": "One row whose value is the ledger_sha256 child root."
      },
      {
        "table": "outbox",
        "key": [
          "account_id"
        ],
        "projection": "One row whose value is the outbox_sha256 child root."
      },
      {
        "table": "owner_beta_paper_control",
        "key": [
          "id"
        ],
        "columns": [
          "id",
          "owner_user_id",
          "account_id",
          "strategy_config_id",
          "state",
          "control_epoch",
          "contract_id",
          "contract_sha256",
          "contract_json",
          "cost_profile_id",
          "cost_profile_version",
          "cost_profile_sha256",
          "cohort_sha256",
          "daily_cohort",
          "process_binding",
          "process_binding_sha256",
          "consent_event_id",
          "activation_event_id",
          "last_signal_allocation_sha256",
          "last_signal_date",
          "updated_at"
        ]
      },
      {
        "table": "owner_beta_paper_events",
        "key": [
          "id"
        ],
        "columns": [
          "id",
          "owner_user_id",
          "account_id",
          "control_epoch",
          "kind",
          "actor_user_id",
          "occurred_at",
          "payload",
          "payload_sha256",
          "request_key",
          "pending_target_id",
          "request_canonical",
          "request_sha256",
          "result_canonical",
          "result_sha256"
        ]
      },
      {
        "table": "pending",
        "key": [
          "account_id"
        ],
        "projection": "One row whose value is the pending_sha256 child root."
      }
    ],

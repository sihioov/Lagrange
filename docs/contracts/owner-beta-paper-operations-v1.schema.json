    {
      "$ref": "#/$defs/intent"
    },
    {
      "$ref": "#/$defs/stage"
    },
    {
      "$ref": "#/$defs/inventory"
    },
    {
      "$ref": "#/$defs/reconciliation"
    },
    {
      "$ref": "#/$defs/drain"
    },
    {
      "$ref": "#/$defs/restore"

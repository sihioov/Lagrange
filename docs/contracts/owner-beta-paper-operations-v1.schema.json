        "realtime_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "monotonic_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "boottime_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },

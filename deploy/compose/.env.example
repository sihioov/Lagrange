# Compose interpolation variables (read from deploy/compose/.env when present).
# Copy this to deploy/compose/.env and adjust. NO secrets — credentials are
# Docker secrets under ../secrets/.
# Parent data root. Compose binds its raw/ and curated/ children separately at
# /data/raw and /data/curated; unrelated artifact roots remain inaccessible.
LAGRANGE_DATA_DIR=../data
LAGRANGE_ARTIFACTS_DIR=../data/artifacts
# Native-Linux service-specific copies created by
# deploy/secrets/provision-runtime-secrets.sh. Do not point this back at the
# operator source files: file-backed Compose secrets otherwise inherit host
# ownership and may be readable by an unintended container UID.
LAGRANGE_RUNTIME_SECRET_DIR=../secrets/runtime
LAGRANGE_PGDATA_VOLUME=lagrange-station-pgdata
# Required only from the CI/release environment; do not invent a placeholder.
# It must be exactly the commit being built, not a branch name or short hash:
#   export LAGRANGE_CODE_COMMIT="$(git rev-parse HEAD)"
#   docker compose --env-file deploy/compose/.env.example build api-server
# The API and backtest-runner images bake this value into their OCI revision
# labels and runtime ENV; Compose does not provide a mutable runtime override.
POSTGRES_USER=lagrange
POSTGRES_DB=lagrange
# API and worker environments are deliberately separate. Production Compose
# requires RESEARCH_APP_ENV explicitly and defaults research fetching to the
# credentialed provider.
API_APP_ENV=production
RESEARCH_APP_ENV=production
RESEARCH_FETCH_MODE=credentialed
RESEARCH_ATTEMPT_TIMEOUT_SECS=900
# Candidate source/price curation is disabled for the credentialed KIS EOD
# minimum release. Synthetic QA smoke enables it explicitly per invocation.
RESEARCH_CANDIDATE_ENABLED=false
# Non-secret, exact licensed-data contract identifier recorded on every Raw
# manifest and resolved to one active candidate-use entitlement in PostgreSQL.
RESEARCH_ENTITLEMENT_REFERENCE=REPLACE_WITH_EXACT_CONTRACT_REFERENCE
RECOMMENDATION_APP_ENV=production
CANDIDATE_APP_ENV=production
PAPER_APP_ENV=production
PAPER_HEALTH_MAX_AGE_SECS=30
PAPER_OPERATION_TIMEOUT_MS=15000
PAPER_CYCLE_TIMEOUT_MS=90000
PAPER_SHUTDOWN_GRACE_MS=20000
# Backtest retention and capacity gates. These values are deliberately
# explicit in production: omitting them must fail closed rather than silently
# allowing claims on an exhausted artifact volume.
BACKTEST_MIN_FREE_BYTES=1073741824
BACKTEST_MAX_QUEUED_BACKTESTS=1000
BACKTEST_RECONCILE_GRACE_SECS=900
BACKTEST_RECONCILE_INTERVAL_SECS=60
# For an explicit local/QA fixture run, override both values together:
# RESEARCH_APP_ENV=qa
# RESEARCH_FETCH_MODE=synthetic
# Internal API origin is used both by the web build's Next.js rewrite and by
# the runtime container; keep it on the private Compose network.
API_INTERNAL_URL=http://api-server:8080
# Create this Docker secret file outside Git; it is the API cursor-signing key.
LAGRANGE_CURSOR_SECRET_SOURCE=../secrets/cursor_secret
# The PostgreSQL admin secret bootstraps roles; migration_owner has its own
# secret so migrations never reuse the cluster administrator credential.
LAGRANGE_DB_MIGRATION_OWNER_PASSWORD_SECRET_SOURCE=../secrets/db_migration_owner_password
# Auth0 first-party Regular Web Application using Client Secret Post.
# Domain, Client ID, and the exact public callback are non-secret configuration.
# Register this URI with Auth0. Nginx routes /auth/* directly to api-server;
# do not point the provider at the private API hostname or the web /callback
# handoff route.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_REDIRECT_URI=https://app.lagrange.local/auth/callback
# Put the Client Secret only in ../secrets/auth0_client_secret; Compose mounts
# it read-only and AUTH0_CLIENT_SECRET_FILE points the API server to that file.
RUST_LOG=info
# Recommendation/API production mode and pin. These values are non-secret;
# fill the pin from the approved immutable curated dataset before startup.
RECOMMENDATION_DATASET_VERSION_ID=
RECOMMENDATION_DATASET_ID=krx_eod_bars
RECOMMENDATION_DATASET_VERSION=
RECOMMENDATION_CURATED_VERSION=
RECOMMENDATION_DATASET_MANIFEST_SHA256=
# Candidate runs discover a coherent exact source set in PostgreSQL, but the
# price Parquet generation remains an explicit deployment pin.
CANDIDATE_HEALTH_MAX_AGE_SECS=180
CANDIDATE_POLL_MS=2000
CANDIDATE_SCHEDULE_POLL_SECS=60
CANDIDATE_SWEEP_MS=30000
CANDIDATE_HEARTBEAT_MS=10000
CANDIDATE_LEASE_MS=60000
CANDIDATE_BACKOFF_MS=30000

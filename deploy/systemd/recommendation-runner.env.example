# Copy to /etc/lagrange/recommendation-runner.env, replace every placeholder,
# and chmod 600 the resulting file. Keep passwords out of this file: the
# runner reads the worker credential from DB_PASSWORD_FILE.

APP_ENV=production
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lagrange
DB_USER=worker
DB_PASSWORD_FILE=/etc/lagrange/secrets/db_worker_password

# Pin the exact immutable curated dataset approved for scheduled runs.
RECOMMENDATION_DATASET_VERSION_ID=
RECOMMENDATION_DATASET_ID=krx_eod_bars
RECOMMENDATION_DATASET_VERSION=
RECOMMENDATION_CURATED_VERSION=
RECOMMENDATION_DATASET_MANIFEST_SHA256=

# The systemd unit sets this same path explicitly and owns the directory.
RECOMMENDATION_HEALTH_STATE_PATH=/run/lagrange-recommendation-runner/health.json
RUST_LOG=info

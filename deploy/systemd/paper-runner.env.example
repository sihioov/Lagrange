# Copy to /etc/lagrange/paper-runner.env, replace every placeholder, and
# chmod 600 the resulting file. This file is intentionally not a secret store;
# keep it outside Git and provision it from the host secret manager.

# The wrapper builds four role-scoped URLs from these non-secret components
# and mounted password files. Direct DATABASE_URL=, WORKER_DATABASE_URL=,
# ADMIN_DATABASE_URL=, and AUDIT_DATABASE_URL= values are intentionally absent.
APP_ENV=production
PAPER_DB_HOST=127.0.0.1
PAPER_DB_PORT=5432
PAPER_DB_NAME=lagrange
PAPER_APP_DB_USER=app
PAPER_WORKER_DB_USER=worker
PAPER_ADMIN_DB_USER=admin
PAPER_AUDIT_DB_USER=audit_writer
PAPER_APP_DB_PASSWORD_FILE=/etc/lagrange/secrets/db_app_password
PAPER_WORKER_DB_PASSWORD_FILE=/etc/lagrange/secrets/db_worker_password
PAPER_ADMIN_DB_PASSWORD_FILE=/etc/lagrange/secrets/db_admin_password
PAPER_AUDIT_DB_PASSWORD_FILE=/etc/lagrange/secrets/db_audit_password

# The curated phase-0 dataset is mounted read-only for this service.
LAGRANGE_DATASET_ROOT=/var/lib/lagrange/data/phase0
LAGRANGE_REPO_ROOT=/opt/lagrange
PAPER_HEALTH_STATE_PATH=/run/lagrange-paper-runner/health.json
PAPER_HEALTH_MAX_AGE_SECS=30

# The worker enforces these finite bounds in-process. SIGTERM is observed
# during an active cycle; a bounded cycle may finish or be canceled before
# this grace expires. Keep this below the unit's TimeoutStopSec.
PAPER_OPERATION_TIMEOUT_MS=15000
PAPER_CYCLE_TIMEOUT_MS=90000
PAPER_SHUTDOWN_GRACE_MS=20000

# Optional deterministic replay date. Leave unset for Seoul-local today.
# PAPER_DATE=2026-01-06

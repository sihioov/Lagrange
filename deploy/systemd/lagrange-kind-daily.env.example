# Coordinator-provisioned non-code configuration for the KIND daily service.
# Keep the actual file outside Git at /etc/lagrange/kind-daily.env with mode
# 0600.  The wrapper refuses execute when this reference is absent or contains
# a line break; it is never printed or included in a request log.
KIND_DAILY_ENTITLEMENT_REFERENCE=REPLACE_WITH_PERSONAL_KIND_ENTITLEMENT_REFERENCE

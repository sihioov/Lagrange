{
  "name": "lagrange-station",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "lagrange-station",
      "version": "0.1.0",
      "workspaces": [
        "apps/*"
      ],
      "engines": {
        "node": ">=24 <25"
      }
    },
    "apps/api-server": {
      "name": "@lagrange/api-server",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@lagrange/web",
      "version": "0.1.0"
    },
    "node_modules/@lagrange/api-server": {
      "resolved": "apps/api-server",
      "link": true
    },
    "node_modules/@lagrange/web": {
      "resolved": "apps/web",
      "link": true
    }
  }
}

# Lagrange Station — environment reference (root).
# Copy to your shell/.env as needed. NO real secrets belong here — every
# credential is a Docker secret under deploy/secrets/ (see its README.md).

# Domain served by the reverse proxy (TLS). Set server_name in
# deploy/nginx/nginx.conf to match.
LAGRANGE_DOMAIN=station.example.com

# Absolute data root in production (bind mounts in compose.yml default to
# ./data relative to deploy/compose; override with an absolute path).
LAGRANGE_DATA_DIR=/srv/lagrange/data
LAGRANGE_ARTIFACTS_DIR=/srv/lagrange/data/artifacts

# PostgreSQL bootstrap (names only — the password is the postgres_password
# secret, never this file).
POSTGRES_USER=lagrange
POSTGRES_DB=lagrange
LAGRANGE_PGDATA_VOLUME=lagrange-station-pgdata

# Auth0 issuer/client identifiers (non-secret; the client SECRET is the
# auth0_client_secret secret).
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id

# RUST_LOG for api-server.
RUST_LOG=info

# Optional compose profiles:
#   docker compose --profile live up -d        -> live-node-owner (Phase 3)
#   docker compose --profile monitoring up -d  -> metrics (Prometheus)
# Neither runs by default.

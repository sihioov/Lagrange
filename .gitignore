# --- Lagrange Station root ignore rules --------------------------------------

# OMC planning/state, drafts, evidence (must stay untracked per plan)
.omo/

# Secrets & credentials — never commit
*.env
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
# Re-include the deployment secret *skeleton* dir only; its own
# deploy/secrets/.gitignore keeps real values ignored and commits only
# *.example placeholders + README.
!deploy/secrets/

# Rust build artifacts
target/
**/target/

# Node
node_modules/
**/node_modules/
npm-debug.log*
.next/
out/
dist/

# Python / uv
.venv/
**/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data (large binary artifacts; design §15-16 keep Raw/NT catalog outside Git)
data/raw/
data/curated/
data/nautilus_catalog/
*.parquet

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

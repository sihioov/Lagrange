{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagrange.local/schemas/market-hours/krx-intraday-session-windows-v1.schema.json",
  "title": "KRX intraday session-window contract v1",
  "description": "Draft 2020-12 closes the JSON shape and encodes the disposition/time rules. Runtime must additionally enforce a positive SPECIAL interval, sorted unique dates, the actual whole-file SHA-256 pin, and evidence_retrieved_at on the same KST civil date as the entry and current evaluation date and not in the future; this schema does not claim those temporal, cross-record, hash, or clock checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exchange",
    "timezone",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exchange": {
      "const": "KRX"
    },
    "timezone": {
      "const": "Asia/Seoul"
    },
    "entries": {
      "type": "array",
      "description": "Runtime requires entries to be sorted by unique date and verifies the actual whole-file SHA-256 pin before use.",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "description": "Runtime also requires evidence_retrieved_at to be same-KST-date and non-future relative to the evaluation instant; JSON Schema cannot compare these values or prove a positive SPECIAL interval.",
      "additionalProperties": false,
      "required": [
        "date",
        "disposition",
        "open_local",
        "close_local",
        "evidence_url",
        "evidence_retrieved_at",
        "evidence_sha256"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "disposition": {
          "enum": [
            "REGULAR",
            "SPECIAL",
            "CLOSED"
          ]
        },
        "open_local": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "close_local": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "evidence_url": {
          "type": "string",
          "pattern": "^https://global\\.krx\\.co\\.kr/[^\\s\\x00-\\x1f\\x7f]+(?![\\s\\S])"
        },
        "evidence_retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "CLOSED"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "open_local": {
                "const": null
              },
              "close_local": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "REGULAR"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "open_local": {
                "const": "09:00:00"
              },
              "close_local": {
                "const": "15:30:00"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "SPECIAL"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "open_local": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
              },
              "close_local": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
              }
            }
          }
        }
      ]
    }
  }
}
